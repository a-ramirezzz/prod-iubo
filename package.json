    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.51.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "framer-motion": "^13.1.1",
    "gray-matter": "^4.0.3",
    "idb": "^8.0.4",
    "jszip": "^3.10.2",
    "next": "16.4.2",
    "next-mdx-remote": "^6.0.0",
