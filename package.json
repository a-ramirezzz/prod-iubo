{
  "name": "prod-uibo",
  "version": "3.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "analyze": "ANALYZE=true next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "test:e2e": "PLAYWRIGHT=true npx playwright test e2e/functional/",
    "test:e2e:ui": "PLAYWRIGHT=true npx playwright test e2e/functional/ --ui",
    "test:visual": "PLAYWRIGHT=true npx playwright test e2e/visual",
    "test:visual:update": "PLAYWRIGHT=true npx playwright test e2e/visual --update-snapshots",
    "test:perf": "PLAYWRIGHT=true npx playwright test --project=performance",
    "test:security": "npx playwright test --project=security",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "types:generate": "supabase gen types typescript --project-id axxbcsqgqszvgozgaczt > src/app/types/database.types.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
